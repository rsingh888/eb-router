# ebRouter environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router
DATABASE_URL=postgres://ebrouter:ebrouter@localhost:5432/ebrouter

# Set ALLOW_SQLITE_FALLBACK=true only for local dev/tests without PostgreSQL.
# ALLOW_SQLITE_FALLBACK=true

# Optional: encrypt secrets at rest (openssl rand -base64 32)
# MASTER_KEY=

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# API rate limiting (requests per minute per IP / per API key on /v1 endpoints)
# API_RATE_LIMIT_PER_MIN=120
# API_RATE_LIMIT_PER_KEY_PER_MIN=300

# Email (Resend preferred). Used for password-reset, team invites, and new-org welcome.
# Without mail config, admins copy reset/invite URLs from Team members.
# APP_URL=https://app.ebrouter.equalbyte.io
# Quote the display-name form. Bare <noreply@...> is rejected by Resend.
# EMAIL_FROM="ebRouter <noreply@equalbyte.io>"
# After mail.equalbyte.io is verified in Resend, switch to:
# EMAIL_FROM="ebRouter <noreply@mail.equalbyte.io>"
# RESEND_API_KEY=
# PASSWORD_RESET_TTL_HOURS=1
# SMTP fallback (used only when RESEND_API_KEY is unset)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=ebrouter@example.com
# SMTP_SECURE=false

# DAST (set in GitHub repository variables for weekly/release ZAP scans)
# STAGING_URL=https://staging.example.com

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://ebrouter.example.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://ebrouter.example.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Deployment mode: onprem (single org per instance) | saas (multi-org hosted)
DEPLOY_MODE=onprem

# SaaS org URLs are path-based: {APP_URL}/o/{slug}/login
# (same as https://app.ebrouter.equalbyte.io/o/acme/login)
# Only set SAAS_BASE_DOMAIN if you use wildcard subdomains (acme.app.example.com).
# SAAS_BASE_DOMAIN=
# NEXT_PUBLIC_SAAS_BASE_DOMAIN=

# Optional dev fallback when not using subdomains (e.g. DEFAULT_ORG_SLUG=acme with /o/acme paths)
# DEFAULT_ORG_SLUG=default

# Optional display name for the default on-prem organization
# INSTANCE_NAME=My Company
