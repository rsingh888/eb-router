# ebRouter SaaS deployment — copy to .env or run install.sh to generate.
# NEVER commit .env to git.

# Docker image (pin a version for production)
EBROUTER_IMAGE=ghcr.io/rsingh888/ebrouter:0.4.56

COMPOSE_PROJECT_NAME=ebrouter-saas

# SaaS base domain — orgs get {slug}.SAAS_BASE_DOMAIN (wildcard DNS + TLS required)
SAAS_BASE_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

# Wildcard TLS via Cloudflare DNS (required for dynamic org subdomains with Caddy)
# Create a scoped token: Zone.DNS Edit for your zone.
CLOUDFLARE_API_TOKEN=

# App bind address (127.0.0.1:20128 when using Caddy proxy profile)
EBROUTER_BIND=127.0.0.1:20128

# PostgreSQL (internal to Docker network)
POSTGRES_USER=ebrouter
POSTGRES_PASSWORD=
POSTGRES_DB=ebrouter

# Required secrets — install.sh generates these if left empty
JWT_SECRET=
API_KEY_SECRET=
MACHINE_ID_SALT=

# Encrypt provider secrets at rest (openssl rand -base64 32). Required — the app will not start without it.
# Do not rotate after go-live; backup this value.
MASTER_KEY=

# Public URLs (HTTPS in production)
BASE_URL=https://app.example.com
NEXT_PUBLIC_BASE_URL=https://app.example.com

# Optional cloud sync
CLOUD_URL=
NEXT_PUBLIC_CLOUD_URL=

# Security
REQUIRE_API_KEY=true
AUTH_COOKIE_SECURE=true
ENABLE_REQUEST_LOGS=false
# Prompt/request logging is off unless explicitly enabled
OBSERVABILITY_ENABLED=false
# Public org registration is off unless explicitly enabled
SAAS_OPEN_REGISTRATION=false

# App-level rate limits (/v1 endpoints — per IP and per API key)
API_RATE_LIMIT_PER_MIN=120
API_RATE_LIMIT_PER_KEY_PER_MIN=300

# Email (Resend preferred). Used for password-reset and team invites.
# APP_URL=https://app.example.com
# EMAIL_FROM=ebRouter <noreply@mail.example.com>
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=false
